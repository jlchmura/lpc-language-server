{
	"compilerOptions": {
		"module": "ESNext",
		"target": "es2020",
		"moduleResolution": "bundler",
		"types": ["vscode", "node"],
		"strict": false,
		"skipLibCheck": true,
		"lib": ["es2020"],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true
	},
	"include": ["src"],
	"exclude": ["node_modules", ".vscode-test"]
}
